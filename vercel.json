{
  "version": 2,
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "https://api.propertpro.com/api/$1"
    },
    {
      "src": "^/oauth/callback$",
      "dest": "https://api.propertpro.com/oauth/callback"
    },
    // serve your SPA for everything else
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
