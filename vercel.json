// vercel.json
{
  "rewrites": [
    {
      "source": "/api/:path*",               // matches both with and without trailing slash
      "destination": "https://…/api/:path*"
    },
    {
      "source": "/:first(users|properties)/:path*",
      "destination": "https://…/api/:first/:path*"
    },
    {
      "source": "/((?!api|_next|static|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
