{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://propertprodjango.onrender.com/api/:path*"
    },
    {
      "source": "/:path*([a-zA-Z]+)/([a-zA-Z0-9_/-]+)",
      "has": [
        {
          "type": "header",
          "key": "content-type",
          "value": "application/json"
        }
      ],
      "destination": "https://propertprodjango.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api|_next|static|favicon.ico|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
