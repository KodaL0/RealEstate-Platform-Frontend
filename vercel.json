{
  "version": 2,
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "https://api.propertpro.com/api/$1"
    },
    {
      "src": "^/accounts/(.*)$",
      "dest": "https://api.propertpro.com/accounts/$1"
    },
    {
      "src": "^/oauth/(.*)$",
      "dest": "https://api.propertpro.com/oauth/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
