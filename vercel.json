{
  "version": 2,
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "https://api.propertpro.com/api/$1"
    },
    {
      "src": "^/accounts/(.*)$",
      "dest": "https://api.propertpro.com/accounts/$1"
    },
    {
      "src": "^/oauth/(.*)$",
      "dest": "https://api.propertpro.com/oauth/$1"
    },
    {
      "src": "^/sitemap-properties\\.xml$",
      "dest": "https://api.propertpro.com/api/properties/sitemap-properties.xml"
    },
    {
      "src": "^/sitemap-profiles\\.xml$",
      "dest": "https://api.propertpro.com/api/properties/sitemap-profiles.xml"
    },
    {
      "src": "^/sitemap-locations\\.xml$",
      "dest": "https://api.propertpro.com/api/properties/sitemap-locations.xml"
    },
    {
      "src": "^/sitemap-developers\\.xml$",
      "dest": "https://api.propertpro.com/api/properties/sitemap-developers.xml"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
